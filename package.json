{
  "name": "komarima",
  "version": "0.3.0",
  "private": true,
  "description": "An Xcode and Liquid Glass-inspired public probe workspace theme for Komari.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": "^22.18.0 || >=24.11.0",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "vite",
    "preview:ui": "vite --mode ui-preview",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:contract": "vitest run tests/contract",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "supply-chain": "node scripts/generate-supply-chain.mjs",
    "supply-chain:check": "node scripts/generate-supply-chain.mjs --check",
    "verify:release-tag": "node scripts/verify-release-tag.mjs",
    "verify:theme": "node scripts/validate-theme.mjs",
    "verify:archive": "node scripts/verify-archive.mjs",
    "package:theme": "node scripts/package-theme.mjs",
    "build:theme": "pnpm build && pnpm verify:theme && pnpm supply-chain:check && pnpm package:theme && pnpm verify:archive"
  },
  "dependencies": {
    "@tanstack/react-query": "5.103.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "uplot": "1.6.32",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@babel/core": "8.0.6",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@rolldown/plugin-babel": "0.2.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "fflate": "0.8.3",
    "globals": "17.12.0",
    "jsdom": "30.1.0",
    "prettier": "3.9.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  }
}
